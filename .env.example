# Copia este archivo a .env y completa los valores.
# NUNCA versionar .env real (ya esta en .gitignore).

# Directorio base del swarm: state.json, venv, logs internos.
# Default si se deja vacio: ~/swarm_auditor
SWARM_HOME=

# Directorio raiz donde viven los proyectos a auditar.
# Default si se deja vacio: $HOME
PROJECTS_HOME=

# Directorio donde se escriben los reportes.
# Default si se deja vacio: ~/auditoria_diaria/logs
LOG_DIR=

# Token de GitHub (scope: public_repo) para evitar el rate limit
# de 60 req/hora en llamadas anonimas a la API de GitHub.
GITHUB_TOKEN=

# --- Pool de proveedores LLM (ensemble multi-modelo) ---
# Todos hablan el protocolo OpenAI-compatible (/v1/chat/completions).
# El rotador (agents/llm_router.py) usa solo los que tengan key seteada;
# necesitas al menos 2 para que el patron scan/debate funcione (nunca
# usa el mismo proveedor para ambos pasos).
NARAROUTER_API_KEY=
TOKENROUTER_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# --- Motor DAST activo (Fase 4, opcional) ---
# Ruta a los templates de nuclei clonados localmente. Default si se deja
# vacio: el directorio de config por defecto de nuclei (~/.config/nuclei/templates).
# Instalacion: go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest
#   git clone --depth=1 https://github.com/projectdiscovery/nuclei-templates.git
NUCLEI_TEMPLATES_DIR=
